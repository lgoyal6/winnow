# Python
/__pycache__
**/__pycache__/
*.pyc
.venv/
venv/
.python-version

# Secrets - never commit
.env
.env.local
.env.*.local

# Editor swap files (vim writes .env.swp etc., which secret scanners flag)
*.swp
*.swo
*~

# eval/experiment artifacts (regenerated; not source)
experiments/eval_results.json
experiments/eval_outputs*.json

# Build artifacts (winnow-core wheel / sdist)
dist/
build/
*.egg-info/
.buildvenv/

# Misc
.DS_Store
*.log

# IDE
.vscode/
.idea/
.claude/

# ngrok tunnel log (written by run.sh)
ngrok.log
